<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">

    <!-- ═══════════════════════════════════════════════════ -->
    <!--   PRIMARY ACCENT — Indigo (dark: lighter tone)     -->
    <!-- ═══════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="PrimaryBrush"        Color="#8470FF" po:Freeze="False"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush"    Color="#755FF8" po:Freeze="False"/>
    <SolidColorBrush x:Key="PrimaryLightBrush"   Color="#2E2E5A" po:Freeze="False"/>

    <!-- ═══════════════════════════════════════════════════ -->
    <!--   SEMANTIC (dark: 400 tonu — koyu bg üzerinde okunabilir) -->
    <!-- ═══════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="SuccessBrush"        Color="#4BD37D" po:Freeze="False"/>  <!-- emerald-400 -->
    <SolidColorBrush x:Key="WarningBrush"        Color="#F7CD4C" po:Freeze="False"/>  <!-- amber-400   -->
    <SolidColorBrush x:Key="DangerBrush"         Color="#FF7474" po:Freeze="False"/>  <!-- red-400     -->
    <SolidColorBrush x:Key="InfoBrush"           Color="#7BC8FF" po:Freeze="False"/>  <!-- blue-400    -->

    <!-- ═══════════════════════════════════════════════════ -->
    <!--   TEXT                                              -->
    <!-- ═══════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="TextPrimaryBrush"    Color="#F3F4F6" po:Freeze="False"/>
    <SolidColorBrush x:Key="TextSecondaryBrush"  Color="#9CA3AF" po:Freeze="False"/>
    <SolidColorBrush x:Key="SubtleBrush"         Color="#8B94A3" po:Freeze="False"/>

    <!-- ═══════════════════════════════════════════════════ -->
    <!--   BORDERS                                           -->
    <!-- ═══════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="BorderBrush"         Color="#2D3747" po:Freeze="False"/>
    <SolidColorBrush x:Key="BorderSubtleBrush"   Color="#2D3747" po:Freeze="False"/>

    <!-- ═══════════════════════════════════════════════════ -->
    <!--   SURFACES                                          -->
    <!-- ═══════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="CardBgBrush"         Color="#1F2937" po:Freeze="False"/>
    <SolidColorBrush x:Key="PageBgBrush"         Color="#111827" po:Freeze="False"/>
    <SolidColorBrush x:Key="TopBarBgBrush"       Color="#111827" po:Freeze="False"/>
    <SolidColorBrush x:Key="HoverBgBrush"        Color="#2B3545" po:Freeze="False"/>
    <SolidColorBrush x:Key="ClickableCardHoverBrush" Color="#2B3545" po:Freeze="False"/>
    <SolidColorBrush x:Key="SurfaceSunkenBrush"  Color="#172033" po:Freeze="False"/>
    <SolidColorBrush x:Key="AiSummaryBgBrush"    Color="#25244A" po:Freeze="False"/>
    <SolidColorBrush x:Key="AiSummaryBorderBrush" Color="#4634B1" po:Freeze="False"/>
    <SolidColorBrush x:Key="AiSummaryRuleBrush"  Color="#3A3C70" po:Freeze="False"/>
    <SolidColorBrush x:Key="AiFloatingBgBrush"   Color="#1F2937" po:Freeze="False"/>
    <SolidColorBrush x:Key="AiFloatingHoverBrush" Color="#2B3545" po:Freeze="False"/>
    <SolidColorBrush x:Key="AiFloatingBorderBrush" Color="#374151" po:Freeze="False"/>
    <SolidColorBrush x:Key="AiFloatingTextBrush" Color="#F3F4F6" po:Freeze="False"/>

    <!-- ═══════════════════════════════════════════════════ -->
    <!--   SIDEBAR                                            -->
    <!-- ═══════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="SidebarBgBrush"          Color="#1F2937" po:Freeze="False"/>
    <SolidColorBrush x:Key="SidebarBorderBrush"      Color="#2D3747" po:Freeze="False"/>
    <SolidColorBrush x:Key="SidebarHoverBrush"        Color="#2B3545" po:Freeze="False"/>
    <SolidColorBrush x:Key="SidebarActiveBgBrush"     Color="#2E2E5A" po:Freeze="False"/>
    <SolidColorBrush x:Key="SidebarTextBrush"         Color="#9CA3AF" po:Freeze="False"/>
    <SolidColorBrush x:Key="SidebarActiveTextBrush"   Color="#F3F4F6" po:Freeze="False"/>
    <SolidColorBrush x:Key="SidebarMutedBrush"        Color="#6B7280" po:Freeze="False"/>
    <SolidColorBrush x:Key="SidebarIconBrush"         Color="#6B7280" po:Freeze="False"/>
    <SolidColorBrush x:Key="SidebarIconActiveBrush"   Color="#8470FF" po:Freeze="False"/>
    <!-- Mosaic: aktif menü öğesi — soldan sağa violet gradyanı -->
    <LinearGradientBrush x:Key="SidebarActiveGradientBrush" StartPoint="0,0.5" EndPoint="1,0.5" po:Freeze="False">
        <GradientStop Color="#3D8470FF" Offset="0"/>
        <GradientStop Color="#0A8470FF" Offset="1"/>
    </LinearGradientBrush>

    <!-- ═══════════════════════════════════════════════════ -->
    <!--   INTERACTION                                       -->
    <!-- ═══════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="ScrollBarThumbBrush"      Color="#4B5563" po:Freeze="False"/>
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#6B7280" po:Freeze="False"/>
    <SolidColorBrush x:Key="SubtleHoverBrush"         Color="#2B3545" po:Freeze="False"/>
    <SolidColorBrush x:Key="GhostHoverBrush"          Color="#2B3545" po:Freeze="False"/>

    <!-- ═══════════════════════════════════════════════════ -->
    <!--   COMPONENT TOKENS                                  -->
    <!-- ═══════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="DataGridHoverBrush"       Color="#243040" po:Freeze="False"/>
    <SolidColorBrush x:Key="DataGridGridLineBrush"    Color="#2D3747" po:Freeze="False"/>
    <SolidColorBrush x:Key="DangerSubtleBrush"        Color="#3F1D22" po:Freeze="False"/>
    <SolidColorBrush x:Key="CardSubtleBgBrush"        Color="#243040" po:Freeze="False"/>
    <SolidColorBrush x:Key="WarningSubtleBgBrush"     Color="#3D3010" po:Freeze="False"/>
    <SolidColorBrush x:Key="WarningSubtleBorderBrush" Color="#816316" po:Freeze="False"/>  <!-- amber-800  -->
    <SolidColorBrush x:Key="WarningSubtleTextBrush"   Color="#FFE081" po:Freeze="False"/>  <!-- amber-300  -->
    <SolidColorBrush x:Key="SuccessSubtleBgBrush"     Color="#123524" po:Freeze="False"/>
    <SolidColorBrush x:Key="SuccessSubtleBorderBrush" Color="#15773A" po:Freeze="False"/>  <!-- emerald-800 -->
    <SolidColorBrush x:Key="InfoSubtleBgBrush"        Color="#12324B" po:Freeze="False"/>
    <SolidColorBrush x:Key="InfoSubtleBorderBrush"    Color="#1C71AE" po:Freeze="False"/>  <!-- blue-800    -->
    <SolidColorBrush x:Key="InfoSubtleTextBrush"      Color="#A0D7FF" po:Freeze="False"/>  <!-- blue-300    -->
    <SolidColorBrush x:Key="DangerSubtleBorderBrush"  Color="#941818" po:Freeze="False"/>  <!-- red-900     -->
    <SolidColorBrush x:Key="DangerEmphasisBrush"      Color="#FF9494" po:Freeze="False"/>  <!-- red-300     -->
    <SolidColorBrush x:Key="SuccessEmphasisBrush"     Color="#8BF0B0" po:Freeze="False"/>  <!-- emerald-300 -->
    <SolidColorBrush x:Key="SuccessSubtleTextBrush"   Color="#8BF0B0" po:Freeze="False"/>  <!-- emerald-300 -->
    <SolidColorBrush x:Key="ChipBgBrush"              Color="#2B3545" po:Freeze="False"/>
    <SolidColorBrush x:Key="ChipTextBrush"            Color="#9CA3AF" po:Freeze="False"/>
    <SolidColorBrush x:Key="FocusRingBrush"           Color="#5D47DE" po:Freeze="False"/>
    <SolidColorBrush x:Key="OverlayBrush"             Color="#A6000000" po:Freeze="False"/> <!-- black 65% -->
    <SolidColorBrush x:Key="TooltipBgBrush"           Color="#0F172A" po:Freeze="False"/>
    <SolidColorBrush x:Key="TooltipFgBrush"           Color="#F1F5F9" po:Freeze="False"/>

    <!-- Splash / login başlangıç paleti — macOS dark referansı -->
    <SolidColorBrush x:Key="SplashBackgroundBrush" Color="#111827" po:Freeze="False"/>
    <SolidColorBrush x:Key="SplashForegroundBrush" Color="#F3F4F6" po:Freeze="False"/>
    <SolidColorBrush x:Key="SplashMutedBrush"      Color="#9CA3AF" po:Freeze="False"/>
    <SolidColorBrush x:Key="SplashSubtleBrush"     Color="#71717A" po:Freeze="False"/>
    <SolidColorBrush x:Key="SplashLineBrush"       Color="#2D3747" po:Freeze="False"/>
    <SolidColorBrush x:Key="SplashLoaderBrush"     Color="#8470FF" po:Freeze="False"/>
    <SolidColorBrush x:Key="SplashNoiseBrush"      Color="#F3F4F6" po:Freeze="False"/>
    <SolidColorBrush x:Key="SplashPanelBrush"      Color="#1F2937" po:Freeze="False"/>
    <SolidColorBrush x:Key="SplashInputBrush"      Color="#1F2937" po:Freeze="False"/>
    <SolidColorBrush x:Key="SplashActionBrush"     Color="#8470FF" po:Freeze="False"/>
    <SolidColorBrush x:Key="SplashActionTextBrush" Color="#FFFFFF" po:Freeze="False"/>
    <Color x:Key="SplashLogoStartColor">#9C8CFF</Color>
    <Color x:Key="SplashLogoEndColor">#755FF8</Color>

    <!-- Login ekranı — macOS dark referansı -->
    <SolidColorBrush x:Key="LoginWindowBrush"      Color="#1F2937" po:Freeze="False"/>
    <SolidColorBrush x:Key="LoginSidebarBrush"     Color="#111827" po:Freeze="False"/>
    <SolidColorBrush x:Key="LoginTextBrush"        Color="#F3F4F6" po:Freeze="False"/>
    <SolidColorBrush x:Key="LoginMutedBrush"       Color="#9CA3AF" po:Freeze="False"/>
    <SolidColorBrush x:Key="LoginAccentBrush"      Color="#8470FF" po:Freeze="False"/>
    <SolidColorBrush x:Key="LoginBorderBrush"      Color="#2D3747" po:Freeze="False"/>
    <SolidColorBrush x:Key="LoginInputBrush"       Color="#1F2937" po:Freeze="False"/>
    <SolidColorBrush x:Key="LoginInputBorderBrush" Color="#374151" po:Freeze="False"/>
    <SolidColorBrush x:Key="LoginSecurityBrush"    Color="#2E2E5A" po:Freeze="False"/>

    <!-- ═══════════════════════════════════════════════════ -->
    <!--   RADIUS TOKENS                                     -->
    <!-- ═══════════════════════════════════════════════════ -->
    <CornerRadius x:Key="RadiusSm">4</CornerRadius>
    <CornerRadius x:Key="RadiusMd">6</CornerRadius>
    <CornerRadius x:Key="RadiusLg">8</CornerRadius>
    <CornerRadius x:Key="RadiusXl">12</CornerRadius>
    <CornerRadius x:Key="Radius2Xl">16</CornerRadius>
    <CornerRadius x:Key="RadiusFull">999</CornerRadius>

    <!-- ═══════════════════════════════════════════════════ -->
    <!--   SPACING TOKENS (Thickness)                        -->
    <!-- ═══════════════════════════════════════════════════ -->
    <Thickness x:Key="Space4">4</Thickness>
    <Thickness x:Key="Space8">8</Thickness>
    <Thickness x:Key="Space12">12</Thickness>
    <Thickness x:Key="Space16">16</Thickness>
    <Thickness x:Key="Space20">20</Thickness>
    <Thickness x:Key="Space24">24</Thickness>
    <Thickness x:Key="Space32">32</Thickness>
    <Thickness x:Key="Space48">48</Thickness>

    <!-- ═══════════════════════════════════════════════════ -->
    <!--   ELEVATION / SHADOWS (dark: daha derin/koyu)       -->
    <!-- ═══════════════════════════════════════════════════ -->
    <DropShadowEffect x:Key="ShadowSm"  Color="#000000" Opacity="0.30" BlurRadius="4"  ShadowDepth="1" Direction="270"/>
    <DropShadowEffect x:Key="ShadowMd"  Color="#000000" Opacity="0.40" BlurRadius="10" ShadowDepth="2" Direction="270"/>
    <DropShadowEffect x:Key="ShadowLg"  Color="#000000" Opacity="0.50" BlurRadius="20" ShadowDepth="4" Direction="270"/>
    <DropShadowEffect x:Key="ShadowXl"  Color="#000000" Opacity="0.60" BlurRadius="32" ShadowDepth="8" Direction="270"/>

</ResourceDictionary>
