<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">

    <!-- ═══════════════════════════════════════════════════ -->
    <!--   PRIMARY ACCENT — Indigo                           -->
    <!-- ═══════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="PrimaryBrush"        Color="#755FF8" po:Freeze="False"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush"    Color="#5D47DE" po:Freeze="False"/>
    <SolidColorBrush x:Key="PrimaryLightBrush"   Color="#F1EEFF" po:Freeze="False"/>

    <!-- ═══════════════════════════════════════════════════ -->
    <!--   SEMANTIC                                          -->
    <!-- ═══════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="SuccessBrush"        Color="#239F52" po:Freeze="False"/>
    <SolidColorBrush x:Key="WarningBrush"        Color="#B7861A" po:Freeze="False"/>
    <SolidColorBrush x:Key="DangerBrush"         Color="#E63939" po:Freeze="False"/>
    <SolidColorBrush x:Key="InfoBrush"           Color="#3193DA" po:Freeze="False"/>

    <!-- ═══════════════════════════════════════════════════ -->
    <!--   TEXT                                              -->
    <!-- ═══════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="TextPrimaryBrush"    Color="#1F2937" po:Freeze="False"/>
    <SolidColorBrush x:Key="TextSecondaryBrush"  Color="#4B5563" po:Freeze="False"/>
    <SolidColorBrush x:Key="SubtleBrush"         Color="#6B7280" po:Freeze="False"/>

    <!-- ═══════════════════════════════════════════════════ -->
    <!--   BORDERS                                           -->
    <!-- ═══════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="BorderBrush"         Color="#E5E7EB" po:Freeze="False"/>
    <SolidColorBrush x:Key="BorderSubtleBrush"   Color="#F3F4F6" po:Freeze="False"/>

    <!-- ═══════════════════════════════════════════════════ -->
    <!--   SURFACES                                          -->
    <!-- ═══════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="CardBgBrush"         Color="#FFFFFF" po:Freeze="False"/>
    <SolidColorBrush x:Key="PageBgBrush"         Color="#F3F4F6" po:Freeze="False"/>
    <SolidColorBrush x:Key="TopBarBgBrush"       Color="#F3F4F6" po:Freeze="False"/>
    <SolidColorBrush x:Key="HoverBgBrush"        Color="#F3F4F6" po:Freeze="False"/>
    <SolidColorBrush x:Key="ClickableCardHoverBrush" Color="#FFFFFF" po:Freeze="False"/>
    <SolidColorBrush x:Key="SurfaceSunkenBrush"  Color="#F9FAFB" po:Freeze="False"/>
    <SolidColorBrush x:Key="AiSummaryBgBrush"    Color="#F1EEFF" po:Freeze="False"/>
    <SolidColorBrush x:Key="AiSummaryBorderBrush" Color="#D2CBFF" po:Freeze="False"/>
    <SolidColorBrush x:Key="AiSummaryRuleBrush"  Color="#E6E1FF" po:Freeze="False"/>
    <SolidColorBrush x:Key="AiFloatingBgBrush"   Color="#FFFFFF" po:Freeze="False"/>
    <SolidColorBrush x:Key="AiFloatingHoverBrush" Color="#F1EEFF" po:Freeze="False"/>
    <SolidColorBrush x:Key="AiFloatingBorderBrush" Color="#D2CBFF" po:Freeze="False"/>
    <SolidColorBrush x:Key="AiFloatingTextBrush" Color="#1F2937" po:Freeze="False"/>

    <!-- ═══════════════════════════════════════════════════ -->
    <!--   SIDEBAR                                            -->
    <!-- ═══════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="SidebarBgBrush"          Color="#FFFFFF" po:Freeze="False"/>
    <SolidColorBrush x:Key="SidebarBorderBrush"      Color="#E5E7EB" po:Freeze="False"/>
    <SolidColorBrush x:Key="SidebarHoverBrush"        Color="#F3F4F6" po:Freeze="False"/>
    <SolidColorBrush x:Key="SidebarActiveBgBrush"     Color="#F1EEFF" po:Freeze="False"/>
    <SolidColorBrush x:Key="SidebarTextBrush"         Color="#6B7280" po:Freeze="False"/>
    <SolidColorBrush x:Key="SidebarActiveTextBrush"   Color="#1F2937" po:Freeze="False"/>
    <SolidColorBrush x:Key="SidebarMutedBrush"        Color="#9CA3AF" po:Freeze="False"/>
    <SolidColorBrush x:Key="SidebarIconBrush"         Color="#9CA3AF" po:Freeze="False"/>
    <SolidColorBrush x:Key="SidebarIconActiveBrush"   Color="#8470FF" po:Freeze="False"/>
    <!-- Mosaic: aktif menü öğesi — soldan sağa violet gradyanı -->
    <LinearGradientBrush x:Key="SidebarActiveGradientBrush" StartPoint="0,0.5" EndPoint="1,0.5" po:Freeze="False">
        <GradientStop Color="#1F8470FF" Offset="0"/>
        <GradientStop Color="#0A8470FF" Offset="1"/>
    </LinearGradientBrush>

    <!-- ═══════════════════════════════════════════════════ -->
    <!--   INTERACTION                                       -->
    <!-- ═══════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="ScrollBarThumbBrush"      Color="#BFC4CD" po:Freeze="False"/>
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#9CA3AF" po:Freeze="False"/>
    <SolidColorBrush x:Key="SubtleHoverBrush"         Color="#F3F4F6" po:Freeze="False"/>
    <SolidColorBrush x:Key="GhostHoverBrush"          Color="#F3F4F6" po:Freeze="False"/>

    <!-- ═══════════════════════════════════════════════════ -->
    <!--   COMPONENT TOKENS                                  -->
    <!-- ═══════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="DataGridHoverBrush"       Color="#F9FAFB" po:Freeze="False"/>
    <SolidColorBrush x:Key="DataGridGridLineBrush"    Color="#F3F4F6" po:Freeze="False"/>
    <SolidColorBrush x:Key="DangerSubtleBrush"        Color="#FFE8E8" po:Freeze="False"/>
    <SolidColorBrush x:Key="CardSubtleBgBrush"        Color="#F9FAFB" po:Freeze="False"/>
    <SolidColorBrush x:Key="WarningSubtleBgBrush"     Color="#FFF2C9" po:Freeze="False"/>
    <SolidColorBrush x:Key="WarningSubtleBorderBrush" Color="#FFE081" po:Freeze="False"/>
    <SolidColorBrush x:Key="WarningSubtleTextBrush"   Color="#816316" po:Freeze="False"/>  <!-- amber-800  -->
    <SolidColorBrush x:Key="SuccessSubtleBgBrush"     Color="#DDF8E8" po:Freeze="False"/>
    <SolidColorBrush x:Key="SuccessSubtleBorderBrush" Color="#8BF0B0" po:Freeze="False"/>  <!-- emerald-200 -->
    <SolidColorBrush x:Key="InfoSubtleBgBrush"        Color="#E3F3FF" po:Freeze="False"/>
    <SolidColorBrush x:Key="InfoSubtleBorderBrush"    Color="#B6E1FF" po:Freeze="False"/>  <!-- blue-200    -->
    <SolidColorBrush x:Key="InfoSubtleTextBrush"      Color="#1C71AE" po:Freeze="False"/>  <!-- blue-800    -->
    <SolidColorBrush x:Key="DangerSubtleBorderBrush"  Color="#FFB2B2" po:Freeze="False"/>  <!-- red-200     -->
    <SolidColorBrush x:Key="DangerEmphasisBrush"      Color="#C52727" po:Freeze="False"/>  <!-- red-900     -->
    <SolidColorBrush x:Key="SuccessEmphasisBrush"     Color="#15773A" po:Freeze="False"/>  <!-- emerald-900 -->
    <SolidColorBrush x:Key="SuccessSubtleTextBrush"   Color="#15773A" po:Freeze="False"/>  <!-- emerald-900 -->
    <SolidColorBrush x:Key="ChipBgBrush"              Color="#F3F4F6" po:Freeze="False"/>
    <SolidColorBrush x:Key="ChipTextBrush"            Color="#4B5563" po:Freeze="False"/>
    <SolidColorBrush x:Key="FocusRingBrush"           Color="#D2CBFF" po:Freeze="False"/>
    <SolidColorBrush x:Key="OverlayBrush"             Color="#80111827" po:Freeze="False"/> <!-- gray-900 50% -->
    <SolidColorBrush x:Key="TooltipBgBrush"           Color="#111827" po:Freeze="False"/>
    <SolidColorBrush x:Key="TooltipFgBrush"           Color="#F9FAFB" po:Freeze="False"/>

    <!-- Splash / login başlangıç paleti — macOS light referansı -->
    <SolidColorBrush x:Key="SplashBackgroundBrush" Color="#F3F4F6" po:Freeze="False"/>
    <SolidColorBrush x:Key="SplashForegroundBrush" Color="#1F2937" po:Freeze="False"/>
    <SolidColorBrush x:Key="SplashMutedBrush"      Color="#6B7280" po:Freeze="False"/>
    <SolidColorBrush x:Key="SplashSubtleBrush"     Color="#6B7280" po:Freeze="False"/>
    <SolidColorBrush x:Key="SplashLineBrush"       Color="#E5E7EB" po:Freeze="False"/>
    <SolidColorBrush x:Key="SplashLoaderBrush"     Color="#755FF8" po:Freeze="False"/>
    <SolidColorBrush x:Key="SplashNoiseBrush"      Color="#1F2937" po:Freeze="False"/>
    <SolidColorBrush x:Key="SplashPanelBrush"      Color="#FFFFFF" po:Freeze="False"/>
    <SolidColorBrush x:Key="SplashInputBrush"      Color="#FFFFFF" po:Freeze="False"/>
    <SolidColorBrush x:Key="SplashActionBrush"     Color="#755FF8" po:Freeze="False"/>
    <SolidColorBrush x:Key="SplashActionTextBrush" Color="#FFFFFF" po:Freeze="False"/>
    <Color x:Key="SplashLogoStartColor">#8470FF</Color>
    <Color x:Key="SplashLogoEndColor">#755FF8</Color>

    <!-- Login ekranı — macOS light referansı -->
    <SolidColorBrush x:Key="LoginWindowBrush"      Color="#FFFFFF" po:Freeze="False"/>
    <SolidColorBrush x:Key="LoginSidebarBrush"     Color="#F3F4F6" po:Freeze="False"/>
    <SolidColorBrush x:Key="LoginTextBrush"        Color="#1F2937" po:Freeze="False"/>
    <SolidColorBrush x:Key="LoginMutedBrush"       Color="#6B7280" po:Freeze="False"/>
    <SolidColorBrush x:Key="LoginAccentBrush"      Color="#755FF8" po:Freeze="False"/>
    <SolidColorBrush x:Key="LoginBorderBrush"      Color="#E5E7EB" po:Freeze="False"/>
    <SolidColorBrush x:Key="LoginInputBrush"       Color="#FFFFFF" po:Freeze="False"/>
    <SolidColorBrush x:Key="LoginInputBorderBrush" Color="#D1D5DB" po:Freeze="False"/>
    <SolidColorBrush x:Key="LoginSecurityBrush"    Color="#F1EEFF" po:Freeze="False"/>

    <!-- ═══════════════════════════════════════════════════ -->
    <!--   RADIUS TOKENS                                     -->
    <!-- ═══════════════════════════════════════════════════ -->
    <CornerRadius x:Key="RadiusSm">4</CornerRadius>
    <CornerRadius x:Key="RadiusMd">6</CornerRadius>
    <CornerRadius x:Key="RadiusLg">8</CornerRadius>
    <CornerRadius x:Key="RadiusXl">12</CornerRadius>
    <CornerRadius x:Key="Radius2Xl">16</CornerRadius>
    <CornerRadius x:Key="RadiusFull">999</CornerRadius>

    <!-- ═══════════════════════════════════════════════════ -->
    <!--   SPACING TOKENS (Thickness)                        -->
    <!-- ═══════════════════════════════════════════════════ -->
    <Thickness x:Key="Space4">4</Thickness>
    <Thickness x:Key="Space8">8</Thickness>
    <Thickness x:Key="Space12">12</Thickness>
    <Thickness x:Key="Space16">16</Thickness>
    <Thickness x:Key="Space20">20</Thickness>
    <Thickness x:Key="Space24">24</Thickness>
    <Thickness x:Key="Space32">32</Thickness>
    <Thickness x:Key="Space48">48</Thickness>

    <!-- ═══════════════════════════════════════════════════ -->
    <!--   ELEVATION / SHADOWS                               -->
    <!-- ═══════════════════════════════════════════════════ -->
    <DropShadowEffect x:Key="ShadowSm"  Color="#000000" Opacity="0.06" BlurRadius="4"  ShadowDepth="1" Direction="270"/>
    <DropShadowEffect x:Key="ShadowMd"  Color="#000000" Opacity="0.08" BlurRadius="10" ShadowDepth="2" Direction="270"/>
    <DropShadowEffect x:Key="ShadowLg"  Color="#000000" Opacity="0.10" BlurRadius="20" ShadowDepth="4" Direction="270"/>
    <DropShadowEffect x:Key="ShadowXl"  Color="#000000" Opacity="0.14" BlurRadius="32" ShadowDepth="8" Direction="270"/>

</ResourceDictionary>
