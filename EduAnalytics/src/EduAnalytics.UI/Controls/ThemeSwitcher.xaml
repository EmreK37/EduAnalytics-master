<UserControl x:Class="EduAnalytics.UI.Controls.ThemeSwitcher"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
             Width="98" Height="34"
             VerticalAlignment="Center"
             WindowChrome.IsHitTestVisibleInChrome="True">

    <UserControl.Resources>
        <!-- Seçenek düğmesi: 32x32 daire, pasifken soluk, hover/aktifken vurgulu -->
        <Style x:Key="ThemeOptionStyle" TargetType="RadioButton">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="Transparent" CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border x:Name="Pill"
            Background="{DynamicResource CardBgBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="17"
            Opacity="0"
            SnapsToDevicePixels="True">
        <Grid Margin="0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="96" Height="32">
            <!-- Kayan aktif göstergesi (halka) -->
            <Border x:Name="Indicator"
                    Width="32" Height="32"
                    HorizontalAlignment="Left"
                    CornerRadius="16"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    Background="{DynamicResource PrimaryLightBrush}"
                    IsHitTestVisible="False">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="IndicatorShift" X="0"/>
                </Border.RenderTransform>
            </Border>

            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="SystemOption" GroupName="ThemeOption" Tag="System"
                             Style="{StaticResource ThemeOptionStyle}"
                             Click="Option_Click"
                             ToolTip="Sistem teması (otomatik)"
                             AutomationProperties.Name="Sistem temasına geç">
                    <mi:MaterialIcon Kind="Monitor" Width="16" Height="16"/>
                </RadioButton>
                <RadioButton x:Name="LightOption" GroupName="ThemeOption" Tag="Light"
                             Style="{StaticResource ThemeOptionStyle}"
                             Click="Option_Click"
                             ToolTip="Açık tema"
                             AutomationProperties.Name="Açık temaya geç">
                    <mi:MaterialIcon Kind="WeatherSunny" Width="16" Height="16"/>
                </RadioButton>
                <RadioButton x:Name="DarkOption" GroupName="ThemeOption" Tag="Dark"
                             Style="{StaticResource ThemeOptionStyle}"
                             Click="Option_Click"
                             ToolTip="Koyu tema"
                             AutomationProperties.Name="Koyu temaya geç">
                    <mi:MaterialIcon Kind="WeatherNight" Width="16" Height="16"/>
                </RadioButton>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
