<UserControl x:Class="EduAnalytics.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EduAnalytics.UI.ViewModels"
             xmlns:views="clr-namespace:EduAnalytics.UI.Views"
             xmlns:mi="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
             d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <UserControl.Resources>
        <Style x:Key="DashboardKpiCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Padding" Value="20,18,20,16"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Effect" Value="{DynamicResource ShadowSm}"/>
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                    <Setter Property="Background" Value="{DynamicResource ClickableCardHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DashboardExamCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="Effect" Value="{DynamicResource ShadowSm}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                    <Setter Property="Background" Value="{DynamicResource ClickableCardHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DashboardLabelCapsStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        </Style>

        <Style x:Key="DashboardMonoValueStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI, sans-serif"/>
            <Setter Property="FontSize" Value="32"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="LineHeight" Value="32"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="DashboardCaptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="LineHeight" Value="16"/>
            <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="DashboardIconBoxStyle" TargetType="Border">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>

        <Style x:Key="DashboardMetaChipStyle" TargetType="Border" BasedOn="{StaticResource Chip}">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="{DynamicResource ChipBgBrush}"/>
        </Style>

        <Style x:Key="QuickActionCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Padding" Value="14,14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource PageBgBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid Width="Auto"
                  MaxWidth="1500"
                  Margin="40,36,40,80"
                  HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- PAGE HEAD -->
                <Grid Grid.Row="0" Margin="0,0,0,32">
                    <StackPanel>
                        <TextBlock Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   LineHeight="40">
                            <Run Text="İyi çalışmalar," />
                            <Run Text="{Binding DisplayUserName, Mode=OneWay}" Foreground="{DynamicResource PrimaryBrush}" />
                        </TextBlock>
                        <TextBlock Text="Sınav performansı, güvenilirlik analizleri ve öğrenci durumu hakkında günlük özet tablonuz."
                                   FontSize="14"
                                   LineHeight="21"
                                   Margin="0,8,0,0"
                                   Foreground="{DynamicResource SubtleBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>

                <!-- KPI GRID -->
                <UniformGrid Grid.Row="1" Rows="1" Columns="4" Margin="0,0,0,36">
                    <Border Style="{StaticResource DashboardKpiCardStyle}" Margin="0,0,16,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <TextBlock Text="ANALİZE HAZIR" Style="{StaticResource DashboardLabelCapsStyle}" VerticalAlignment="Center"/>
                                <Border Style="{StaticResource DashboardIconBoxStyle}" Background="{DynamicResource InfoSubtleBgBrush}" HorizontalAlignment="Right">
                                    <mi:MaterialIcon Kind="FileDocumentMultipleOutline" Width="18" Height="18" Foreground="{DynamicResource InfoBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,18,0,0">
                                <TextBlock Text="{Binding ExamsReadyForAnalysis}" Style="{StaticResource DashboardMonoValueStyle}"
                                           ToolTip="En az bir öğrencinin cevabı girilmiş sınavlar"/>
                                <TextBlock Text=" Sınav" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource SubtleBrush}" VerticalAlignment="Bottom" Margin="8,0,0,4"/>
                            </StackPanel>

                            <Grid Grid.Row="2" Margin="0,18,0,0" VerticalAlignment="Bottom">
                                <TextBlock Text="{Binding ReadyCaption}" Style="{StaticResource DashboardCaptionStyle}"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource DashboardKpiCardStyle}" Margin="0,0,16,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <TextBlock Text="KAYITLI ÖĞRENCİ" Style="{StaticResource DashboardLabelCapsStyle}" VerticalAlignment="Center"/>
                                <Border Style="{StaticResource DashboardIconBoxStyle}" Background="{DynamicResource SuccessSubtleBgBrush}" HorizontalAlignment="Right">
                                    <mi:MaterialIcon Kind="AccountGroup" Width="18" Height="18" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,18,0,0">
                                <TextBlock Text="{Binding StudentCount}" Style="{StaticResource DashboardMonoValueStyle}"/>
                                <Border Background="{DynamicResource SuccessSubtleBgBrush}" CornerRadius="8" Padding="6,2" Margin="10,4,0,0" VerticalAlignment="Center"
                                        Visibility="{Binding ClassCount, Converter={StaticResource BoolToVisibility}}"
                                        ToolTip="Öğrencilerin kayıtlı olduğu sınıf (şube) sayısı">
                                    <TextBlock Text="{Binding ClassCount, StringFormat={}{0} sınıf}" FontSize="12" Foreground="{DynamicResource SuccessEmphasisBrush}" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>

                            <Grid Grid.Row="2" Margin="0,18,0,0" VerticalAlignment="Bottom">
                                <TextBlock Text="Sistemde kayıtlı öğrenciler" Style="{StaticResource DashboardCaptionStyle}"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource DashboardKpiCardStyle}" Margin="0,0,16,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <TextBlock Text="GENEL ORT. BAŞARI" Style="{StaticResource DashboardLabelCapsStyle}" VerticalAlignment="Center"/>
                                <Border Style="{StaticResource DashboardIconBoxStyle}" Background="{DynamicResource WarningSubtleBgBrush}" HorizontalAlignment="Right">
                                    <mi:MaterialIcon Kind="TrendingUp" Width="18" Height="18" Foreground="{DynamicResource WarningBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,18,0,0">
                                <TextBlock Text="{Binding OverallAverageSuccessRate, StringFormat={}{0:N1}}" Style="{StaticResource DashboardMonoValueStyle}"/>
                                <TextBlock Text="%" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource SubtleBrush}" VerticalAlignment="Bottom" Margin="4,0,0,4"/>
                            </StackPanel>

                            <Grid Grid.Row="2" Margin="0,18,0,0" VerticalAlignment="Bottom">
                                <TextBlock Text="Tüm sınavlardaki genel başarı" Style="{StaticResource DashboardCaptionStyle}"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource DashboardKpiCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <TextBlock Text="SON AKTİVİTE" Style="{StaticResource DashboardLabelCapsStyle}" VerticalAlignment="Center"/>
                                <Border Style="{StaticResource DashboardIconBoxStyle}" Background="{DynamicResource PrimaryLightBrush}" HorizontalAlignment="Right">
                                    <mi:MaterialIcon Kind="CalendarClock" Width="18" Height="18" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,18,0,0">
                                <TextBlock Text="{Binding LastActivityDate}" Style="{StaticResource DashboardMonoValueStyle}" FontSize="22" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Grid Grid.Row="2" Margin="0,18,0,0" VerticalAlignment="Bottom">
                                <TextBlock Text="En son sistem hareketi" Style="{StaticResource DashboardCaptionStyle}"/>
                            </Grid>
                        </Grid>
                    </Border>
                </UniformGrid>

                <!-- MAIN CONTENT AREA: 2 COLUMNS -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="340"/>
                    </Grid.ColumnDefinitions>

                    <!-- SOL: EXAM LIST -->
                    <Grid Grid.Column="0" Margin="0,0,32,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Son Sınav Performansları" FontSize="18.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16"/>

                        <ItemsControl Grid.Row="1" ItemsSource="{Binding FilteredExams}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource DashboardExamCardStyle}">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.OpenAnalysisCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                        </Border.InputBindings>

                                        <Grid Margin="24,20,24,20">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,24,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ExamTitle}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,0,8"/>
                                                
                                                <WrapPanel Margin="0,0,0,2">
                                                    <!-- Sınavın durumu: cevabı girildiyse "Analize hazır", girilmediyse "Cevap bekliyor". -->
                                                    <Border BorderThickness="1" CornerRadius="8" Padding="8,4" Margin="0,0,10,6">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource SuccessSubtleBgBrush}"/>
                                                                <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasAnswers}" Value="False">
                                                                        <Setter Property="Background" Value="{DynamicResource WarningSubtleBgBrush}"/>
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                                                     Fill="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=Border}}"/>
                                                            <TextBlock Margin="6,0,0,0" FontSize="11" FontWeight="Bold">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="Analize hazır"/>
                                                                        <Setter Property="Foreground" Value="{DynamicResource SuccessEmphasisBrush}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasAnswers}" Value="False">
                                                                                <Setter Property="Text" Value="Cevap bekliyor"/>
                                                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Style="{StaticResource DashboardMetaChipStyle}" Margin="0,0,10,6">
                                                        <StackPanel Orientation="Horizontal">
                                                            <mi:MaterialIcon Kind="CalendarClock" Width="14" Height="14" Foreground="{DynamicResource SubtleBrush}" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding ExamDate, StringFormat='{}{0:dd MMMM yyyy}', ConverterCulture=tr-TR}" Margin="6,0,0,0" Style="{StaticResource ChipText}" FontWeight="SemiBold"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Style="{StaticResource DashboardMetaChipStyle}" Margin="0,0,10,6">
                                                        <TextBlock Text="{Binding CourseName}" Style="{StaticResource ChipText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    </Border>
                                                </WrapPanel>
                                                <TextBlock Text="Güvenilirlik ve öğrenim çıktısı riskleri için detaylı analize geçin." FontSize="12.5" Foreground="{DynamicResource SubtleBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <StackPanel Width="80" HorizontalAlignment="Center" Margin="0,0,16,0">
                                                    <TextBlock Text="{Binding TotalStudents}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="ÖĞRENCİ" Style="{StaticResource DashboardLabelCapsStyle}" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Width="80" HorizontalAlignment="Center" Margin="0,0,16,0">
                                                    <TextBlock Text="{Binding TotalQuestions}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="SORU" Style="{StaticResource DashboardLabelCapsStyle}" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Width="90" HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding AverageSuccessRate, StringFormat={}{0:N1}%}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="BAŞARI" Style="{StaticResource DashboardLabelCapsStyle}" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <!-- SAĞ: HIZLI İŞLEMLER -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Hızlı İşlemler" FontSize="18.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16"/>

                        <StackPanel Grid.Row="1">
                            <!-- Optik Okuma -->
                            <Border Style="{StaticResource QuickActionCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource PrimaryBrush}" VerticalAlignment="Center">
                                        <mi:MaterialIcon Kind="Scanner" Width="20" Height="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                                        <TextBlock Text="Optik Okuma" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Formları tara ve içeri aktar" FontSize="12.5" Foreground="{DynamicResource SubtleBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <mi:MaterialIcon Grid.Column="2" Kind="ChevronRight" Width="20" Height="20" Foreground="{DynamicResource SubtleBrush}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Sınav Yönetimi -->
                            <Border Style="{StaticResource QuickActionCardStyle}" Margin="0,4,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource InfoBrush}" VerticalAlignment="Center">
                                        <mi:MaterialIcon Kind="FileDocumentEditOutline" Width="20" Height="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                                        <TextBlock Text="Sınav Yönetimi" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Yeni sınav oluştur veya düzenle" FontSize="12.5" Foreground="{DynamicResource SubtleBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <mi:MaterialIcon Grid.Column="2" Kind="ChevronRight" Width="20" Height="20" Foreground="{DynamicResource SubtleBrush}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Sistem Durumu -->
                            <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="14" Padding="16,16" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="Sistem Durumu" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                                    
                                    <!-- Durum satırları gerçek durumu gösterir: yeşil iyi, amber dikkat, kırmızı hata. -->
                                    <DockPanel Margin="0,0,0,10">
                                        <Ellipse DockPanel.Dock="Left" Width="8" Height="8" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDatabaseConnected}" Value="False">
                                                            <Setter Property="Fill" Value="{DynamicResource DangerBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding DatabaseStatusText}" FontSize="12.5" Foreground="{DynamicResource SubtleBrush}" Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    </DockPanel>

                                    <DockPanel Margin="0,0,0,10">
                                        <Ellipse DockPanel.Dock="Left" Width="8" Height="8" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAiConfigured}" Value="False">
                                                            <Setter Property="Fill" Value="{DynamicResource WarningBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding AiStatusText}" FontSize="12.5" Foreground="{DynamicResource SubtleBrush}" Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"
                                                   ToolTip="API anahtarı Ayarlar'daki yapay zekâ bölümünden girilir. Anahtarın girilip girilmediği denetlenir; sunucuya bağlanılmaz."/>
                                    </DockPanel>

                                    <DockPanel Visibility="{Binding PendingExamsText, Converter={StaticResource BoolToVisibility}}">
                                        <Ellipse DockPanel.Dock="Left" Width="8" Height="8" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasExamsAwaitingAnswers}" Value="True">
                                                            <Setter Property="Fill" Value="{DynamicResource WarningBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding PendingExamsText}" FontSize="12.5" Foreground="{DynamicResource SubtleBrush}" Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <!-- AI Assistant Banner -->
                            <Border Background="{DynamicResource PrimaryLightBrush}" BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1" CornerRadius="14" Padding="16,16" Margin="0,20,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <mi:MaterialIcon Kind="RobotOutline" Width="32" Height="32" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="EduAI Asistanınız Hazır" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                                        <TextBlock Text="Sağ alttaki butondan ulaşabilirsiniz." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </ScrollViewer>

        <views:LoadingOverlay Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
    </Grid>
</UserControl>
