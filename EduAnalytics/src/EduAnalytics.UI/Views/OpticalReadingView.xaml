<UserControl x:Class="EduAnalytics.UI.Views.OpticalReadingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EduAnalytics.UI.ViewModels"
             xmlns:ctl="clr-namespace:EduAnalytics.UI.Controls"
             xmlns:mi="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
             d:DataContext="{d:DesignInstance Type=vm:OpticalReadingViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <UserControl.Resources>
        <!-- Satır durumuna göre renk: Hazır (yeşil), Kontrol et (amber), Öğrenci seçin / Okunamadı (kırmızı), Kaydedildi (mor). -->
        <Style x:Key="StatusPillStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SuccessSubtleBgBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Review">
                    <Setter Property="Background" Value="{DynamicResource WarningSubtleBgBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="NeedsStudent">
                    <Setter Property="Background" Value="{DynamicResource DangerSubtleBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Unreadable">
                    <Setter Property="Background" Value="{DynamicResource DangerSubtleBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Saved">
                    <Setter Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StatusTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SuccessEmphasisBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Review">
                    <Setter Property="Foreground" Value="{DynamicResource WarningSubtleTextBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="NeedsStudent">
                    <Setter Property="Foreground" Value="{DynamicResource DangerEmphasisBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Unreadable">
                    <Setter Property="Foreground" Value="{DynamicResource DangerEmphasisBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Saved">
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Uyarı şeridi: öğrenci bulunamadı / okunamadı kırmızı, diğerleri amber. -->
        <Style x:Key="WarningStripStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource WarningSubtleBgBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="NeedsStudent">
                    <Setter Property="Background" Value="{DynamicResource DangerSubtleBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Unreadable">
                    <Setter Property="Background" Value="{DynamicResource DangerSubtleBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="WarningStripTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource WarningSubtleTextBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="NeedsStudent">
                    <Setter Property="Foreground" Value="{DynamicResource DangerEmphasisBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Unreadable">
                    <Setter Property="Foreground" Value="{DynamicResource DangerEmphasisBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CellCaptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Opacity" Value="0.7"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="SectionCaptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <!-- "Alınan Not" kutusu: incelenmesi gerekenler (belirsiz, boş, optikle uyuşmayan) amber çerçeveli. -->
        <Style x:Key="ScoreCellStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFlagged}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource WarningSubtleBgBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TotalCheckTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding TotalMismatch}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource DangerEmphasisBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ScanImageFrameStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Padding" Value="2"/>
        </Style>
    </UserControl.Resources>

    <Grid Style="{StaticResource PageRootGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ctl:PageHeader Grid.Row="0"
                        Icon="Scanner"
                        Title="Optik Okuma"
                        Subtitle="Resmi sınav kâğıdını (antet, Soru Numarası / Alınan Not tablosu, test cevap alanı) üretin; taranan kâğıtlarda öğrenci numarası, test cevapları, her sorunun el yazısı puanı ve Toplam Not otomatik okunur. Puanları kırpılmış tablo görüntüsüyle karşılaştırıp düzeltin, onaylayınca kaydedin.">
            <ctl:PageHeader.Actions>
                <StackPanel Orientation="Horizontal">
                    <Button Command="{Binding GenerateFormCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            IsEnabled="{Binding HasExamLoaded}"
                            Margin="0,0,8,0"
                            ToolTip="Seçili sınav için antetli, puan tablolu sınav kâğıdı (PDF) üret">
                        <StackPanel Orientation="Horizontal">
                            <mi:MaterialIcon Kind="FilePdfBox" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Sınav Kâğıdı Üret"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding GenerateSamplesCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            IsEnabled="{Binding HasExamLoaded}"
                            Margin="0,0,8,0"
                            ToolTip="Kayıtlı öğrenciler için el yazısıyla doldurulmuş örnek kâğıtlar (taranmış görüntü) üretir ve hemen okur. Kâğıt ve tarayıcı olmadan tüm akışı denemek içindir; kaydetmek yine onayınıza bağlıdır.">
                        <StackPanel Orientation="Horizontal">
                            <mi:MaterialIcon Kind="FlaskOutline" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Örnek Kâğıt Üret ve Oku"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ImportScansCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            IsEnabled="{Binding HasExamLoaded}"
                            ToolTip="Taranmış kâğıtları (PDF, JPEG, PNG) yükle ve oku">
                        <StackPanel Orientation="Horizontal">
                            <mi:MaterialIcon Kind="Upload" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Tarama Yükle"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ctl:PageHeader.Actions>
        </ctl:PageHeader>

        <!-- Mesajlar -->
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <Border Style="{StaticResource AlertErrorStyle}"
                    Margin="0,0,0,6"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerEmphasisBrush}" TextWrapping="Wrap"/>
            </Border>
            <Border Style="{StaticResource AlertSuccessStyle}"
                    Visibility="{Binding SuccessMessage, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding SuccessMessage}" Foreground="{DynamicResource SuccessEmphasisBrush}" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>

        <!-- Sınav seçimi -->
        <Border Grid.Row="2" Style="{StaticResource BentoCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Sınav:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding Exams}"
                          SelectedItem="{Binding SelectedExam}"
                          DisplayMemberPath="Title"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Center"/>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ExamInfo}" Opacity="0.75" VerticalAlignment="Center"/>
                    <ProgressBar Width="120" Height="4" Margin="16,0,8,0"
                                 IsIndeterminate="True"
                                 VerticalAlignment="Center"
                                 Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVisibility}}"/>
                    <TextBlock Text="{Binding ProcessingStatus}" Opacity="0.75" VerticalAlignment="Center"
                               Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- İnceleme ızgarası -->
        <Border Grid.Row="3" Style="{StaticResource BentoCardStyle}" Margin="0,12,0,0">
            <Grid>
                <!-- Satır yüksekliği içeriğe göre büyür; puan tablosu ve uyarılar satırın altında tam genişlikte gösterilir. -->
                <DataGrid ItemsSource="{Binding Sheets}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          SelectionMode="Single"
                          RowHeight="NaN"
                          MinRowHeight="58"
                          RowDetailsVisibilityMode="Visible"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Pixel">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Sayfa" Width="1.1*" MinWidth="150" SortMemberPath="StatusText">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center" Margin="0,6">
                                        <Border Style="{StaticResource StatusPillStyle}" CornerRadius="{DynamicResource RadiusLg}"
                                                Padding="8,3" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource StatusTextStyle}"
                                                       FontSize="11.5" FontWeight="SemiBold"/>
                                        </Border>
                                        <TextBlock Text="{Binding SourceLabel}" Style="{StaticResource CellCaptionStyle}"
                                                   ToolTip="{Binding SourceLabel}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Kâğıttan okunan" Width="1.3*" MinWidth="170" SortMemberPath="OcrNumber">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center" Margin="0,6">
                                        <TextBlock Text="{Binding OcrNumber}" FontWeight="SemiBold" FontFamily="Consolas"
                                                   ToolTip="Öğrenci numarası (numara kutularından el yazısı tanıma ile okundu; '?' boş kutu)"/>
                                        <Border Style="{StaticResource ScanImageFrameStyle}" Margin="0,4,0,0"
                                                Visibility="{Binding NumberImage, Converter={StaticResource BoolToVisibility}}">
                                            <Image Source="{Binding NumberImage}" Height="24" Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   ToolTip="Kâğıttaki numara kutuları (taranan görüntü)"/>
                                        </Border>
                                        <TextBlock Text="{Binding OcrName}" Style="{StaticResource CellCaptionStyle}"
                                                   ToolTip="Ad-soyad alanından metin tanıma (OCR) ile okunan ad"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Öğrenci" Width="1.6*" MinWidth="210">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center" Margin="0,4">
                                        <ComboBox ItemsSource="{Binding DataContext.MatchableStudents, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedItem="{Binding SelectedStudent, UpdateSourceTrigger=PropertyChanged}"
                                                  DisplayMemberPath="Display"
                                                  IsEnabled="{Binding MarkersFound}"/>
                                        <TextBlock Text="{Binding MatchInfo}" Style="{StaticResource CellCaptionStyle}" Margin="2,3,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Kitapçık" Width="96" MinWidth="96">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DataContext.AvailableBookletCodes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              SelectedItem="{Binding BookletCode, UpdateSourceTrigger=PropertyChanged}"
                                              IsEnabled="{Binding MarkersFound}"
                                              VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Test cevapları (– boş, ? çift)" Width="1.2*" MinWidth="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid VerticalAlignment="Center" Margin="0,4">
                                        <TextBox Text="{Binding AnswersText, UpdateSourceTrigger=LostFocus}"
                                                 ToolTip="Test sorularının optik alandan okunan şıkları (5'erli gruplu). A–E: işaretli şık, '-': boş, '?': birden fazla işaret. Gerekirse elle düzeltebilirsiniz."
                                                 FontFamily="Consolas"
                                                 TextWrapping="Wrap"
                                                 IsEnabled="{Binding MarkersFound}"
                                                 Visibility="{Binding DataContext.HasMultipleChoice, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}"/>
                                        <TextBlock Text="Test sorusu yok" Style="{StaticResource CellCaptionStyle}"
                                                   Visibility="{Binding DataContext.HasMultipleChoice, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"/>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Sonuç" Binding="{Binding ResultText}" IsReadOnly="True" Width="1.2*" MinWidth="150">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="ToolTip" Value="Test: cevap anahtarına göre doğru (D) · yanlış (Y) · boş (B). Klasik: Alınan Not kutularındaki puanlar. Kaydedince bu değerlendirme veritabanına yazılır."/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Güven" Binding="{Binding ConfidenceDisplay}" IsReadOnly="True" Width="74" MinWidth="74">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="ToolTip" Value="Numaranın, işaretli cevapların ve okunan puanların okuma netliği (en düşük olanı)."/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTemplateColumn Width="44" MinWidth="44">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.RemoveSheetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Padding="4"
                                            VerticalAlignment="Center"
                                            ToolTip="Bu kâğıdı listeden çıkar">
                                        <mi:MaterialIcon Kind="Close" Width="14" Height="14"/>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>

                    <DataGrid.RowDetailsTemplate>
                        <DataTemplate>
                            <StackPanel Margin="8,0,8,10">
                                <!-- Uyarılar -->
                                <Border Style="{StaticResource WarningStripStyle}"
                                        CornerRadius="{DynamicResource RadiusMd}"
                                        Padding="10,6" Margin="0,0,0,6"
                                        Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVisibility}}">
                                    <DockPanel>
                                        <mi:MaterialIcon DockPanel.Dock="Left" Kind="AlertOutline" Width="15" Height="15"
                                                         Margin="0,1,8,0" VerticalAlignment="Top"
                                                         Foreground="{Binding Foreground, ElementName=WarningText}"/>
                                        <TextBlock x:Name="WarningText" Text="{Binding WarningsText}" TextWrapping="Wrap"
                                                   Style="{StaticResource WarningStripTextStyle}" LineHeight="18"/>
                                    </DockPanel>
                                </Border>
                                <!-- Soru Numarası / Alınan Not: kırpılmış tablo ve okunan puanlar (düzenlenebilir) -->
                                <Border Background="{DynamicResource CardSubtleBgBrush}"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                        CornerRadius="{DynamicResource RadiusMd}" Padding="12,10"
                                        Visibility="{Binding HasScores, Converter={StaticResource BoolToVisibility}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <TextBlock Text="Soru Numarası / Alınan Not — taranan tablo ve okunan puanlar" Style="{StaticResource SectionCaptionStyle}"/>
                                            <Border Style="{StaticResource ScanImageFrameStyle}" MaxWidth="1000">
                                                <Image Source="{Binding ScoreTableImage}" Stretch="Uniform" MaxHeight="150"
                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                       ToolTip="Kâğıttaki puan tablosu (taranan görüntüden kırpıldı)"/>
                                            </Border>
                                            <ItemsControl ItemsSource="{Binding Scores}" Margin="0,8,0,0" Focusable="False">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{StaticResource ScoreCellStyle}" Width="84" Margin="0,0,6,6" Padding="6,4"
                                                                ToolTip="{Binding FlagReason}">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Header}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                                <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged, Delay=350}"
                                                                         HorizontalContentAlignment="Center" FontFamily="Consolas" Margin="0,3"
                                                                         ToolTip="Alınan Not kutusundan okunan puan; gerekirse düzeltin (ör. 7,5). Boş: puan girilmemiş."/>
                                                                <TextBlock Text="{Binding Caption}" FontSize="10.5" Opacity="0.75"
                                                                           HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <!-- Toplam Not – Paraf kutusu: kontrol amaçlı okunur -->
                                        <StackPanel Grid.Column="1" Width="210" Margin="18,0,0,0">
                                            <TextBlock Text="Toplam Not (kâğıttaki)" Style="{StaticResource SectionCaptionStyle}"/>
                                            <Border Style="{StaticResource ScanImageFrameStyle}"
                                                    Visibility="{Binding TotalImage, Converter={StaticResource BoolToVisibility}}">
                                                <Image Source="{Binding TotalImage}" Height="86" Stretch="Uniform"
                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                       ToolTip="Kâğıttaki Toplam Not – Paraf kutusu (taranan görüntü)"/>
                                            </Border>
                                            <TextBox Text="{Binding TotalText, UpdateSourceTrigger=PropertyChanged, Delay=350}"
                                                     Width="96" HorizontalAlignment="Left" HorizontalContentAlignment="Center"
                                                     FontFamily="Consolas" Margin="0,8,0,4"
                                                     ToolTip="Toplam Not kutusundan okunan değer; soru puanlarının toplamıyla karşılaştırılır."/>
                                            <TextBlock Text="{Binding TotalCheckText}" Style="{StaticResource TotalCheckTextStyle}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </DataGrid.RowDetailsTemplate>
                </DataGrid>

                <!-- DataGrid'den SONRA tanımlı: boş-durum mesajı üst katmanda kalır. -->
                <TextBlock Text="Henüz tarama yüklenmedi. Bir sınav seçin, sınav kâğıdını üretip yazdırın; puanlar Alınan Not satırına yazıldıktan sonra taramaları buraya yükleyin. Kâğıt olmadan denemek için &quot;Örnek Kâğıt Üret ve Oku&quot; düğmesini kullanabilirsiniz."
                           Opacity="0.55" TextWrapping="Wrap"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding Sheets.Count, Converter={StaticResource CollectionEmptyToVisibility}}"/>
            </Grid>
        </Border>

        <!-- Kaydet -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <TextBlock VerticalAlignment="Center" Opacity="0.7" Margin="0,0,12,0">
                <Run Text="{Binding Sheets.Count, Mode=OneWay}"/>
                <Run Text="kâğıt yüklendi"/>
            </TextBlock>
            <Button Command="{Binding SaveAllCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    IsEnabled="{Binding HasExamLoaded}"
                    ToolTip="Eşleşmiş tüm kâğıtların test cevaplarını ve klasik soru puanlarını veritabanına kaydet">
                <StackPanel Orientation="Horizontal">
                    <mi:MaterialIcon Kind="ContentSaveOutline" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Cevapları ve Puanları Kaydet"/>
                </StackPanel>
            </Button>
        </StackPanel>
        <!-- Overlay -->
        <Border Grid.RowSpan="5" Background="{DynamicResource OverlayBrush}" Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVisibility}}" Panel.ZIndex="100">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Width="250" Height="6" IsIndeterminate="True" Margin="0,0,0,16"/>
                <TextBlock Text="Kâğıtlar okunuyor, lütfen bekleyin..." Foreground="White" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding ProcessingStatus}" Foreground="#DDDDDD" FontSize="13" HorizontalAlignment="Center" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
