<UserControl x:Class="EduAnalytics.UI.Views.ExamManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EduAnalytics.UI.ViewModels"
             xmlns:views="clr-namespace:EduAnalytics.UI.Views"
             xmlns:ctl="clr-namespace:EduAnalytics.UI.Controls"
             xmlns:enums="clr-namespace:EduAnalytics.Core.Enums;assembly=EduAnalytics.Core"
             xmlns:mi="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
             d:DataContext="{d:DesignInstance Type=vm:ExamManagementViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <UserControl.Resources>
        <Style x:Key="PointInputStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="72"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>
    </UserControl.Resources>

    <Grid Style="{StaticResource PageRootGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ctl:PageHeader Grid.Row="0"
                        Icon="FileDocumentMultipleOutline"
                        Title="Sınav Yönetimi"
                        Subtitle="Oluşturulan sınavları görüntüleyin, analiz ekranına geçin, soru ekleyin veya temel bilgileri düzenleyin."/>

        <StackPanel Grid.Row="1">
            <Border Style="{StaticResource AlertErrorStyle}"
                    Margin="0,0,0,8"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerEmphasisBrush}" TextWrapping="Wrap"/>
            </Border>
            <Border Style="{StaticResource AlertSuccessStyle}"
                    Margin="0,0,0,8"
                    Visibility="{Binding SuccessMessage, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding SuccessMessage}" Foreground="{DynamicResource SuccessEmphasisBrush}" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>

        <ScrollViewer Style="{StaticResource PageScrollViewerStyle}" Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Exams}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource BentoCardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,18,0">
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="16" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Border Background="{DynamicResource PrimaryLightBrush}" CornerRadius="{DynamicResource RadiusLg}" Padding="7,3" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding ExamType, Converter={StaticResource ExamTypeLabel}}" Foreground="{DynamicResource PrimaryBrush}"
                                                       FontSize="11" FontWeight="SemiBold"/>
                                        </Border>
                                        <TextBlock Text="{Binding CourseName}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="  /  " Foreground="{DynamicResource SubtleBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding ExamDate, StringFormat='{}{0:dd.MM.yyyy}'}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="  /  " Foreground="{DynamicResource SubtleBrush}" VerticalAlignment="Center"/>
                                        <TextBlock VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}">
                                            <Run Text="{Binding DurationMinutes}"/>
                                            <Run Text=" dk"/>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Width="98" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TotalQuestions}"
                                               FontSize="18.5" FontWeight="Bold"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="Soru" Style="{StaticResource MetricLabelStyle}"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Width="98" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TotalAnswers}"
                                               FontSize="18.5" FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource PrimaryBrush}"/>
                                    <TextBlock Text="Cevap" Style="{StaticResource MetricLabelStyle}"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Analiz"
                                            Command="{Binding DataContext.OpenAnalysisCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Padding="12,7"
                                            Margin="0,0,6,0"/>
                                    <Button Content="Soru Ekle"
                                            Command="{Binding DataContext.OpenAddQuestionsCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Padding="12,7"
                                            Margin="0,0,6,0"
                                            ToolTip="Soru bankasından bu sınava yeni soru ekle"/>
                                    <Button Content="Düzenle"
                                            Command="{Binding DataContext.EditCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Padding="12,7"
                                            Margin="0,0,6,0"/>
                                    <Button Content="Sil"
                                            Command="{Binding DataContext.DeleteCommand,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource DangerButtonStyle}"
                                            Padding="12,7"/>
                                </StackPanel>

                                <Border Grid.Row="1" Grid.ColumnSpan="4"
                                        Background="{DynamicResource PageBgBrush}"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource RadiusLg}"
                                        Padding="12"
                                        Margin="0,16,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Sınav soruları"
                                                   Style="{StaticResource CaptionStyle}"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,8"/>
                                        <ItemsControl ItemsSource="{Binding Questions}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="46"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="64"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding QuestionNumber, StringFormat={}S{0}}"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource PrimaryBrush}"/>
                                                        <Border Grid.Column="1"
                                                                Background="{DynamicResource PrimaryLightBrush}"
                                                                CornerRadius="{DynamicResource RadiusLg}"
                                                                Padding="5,2"
                                                                VerticalAlignment="Center"
                                                                Margin="0,0,8,0">
                                                            <TextBlock Text="{Binding Type, Converter={StaticResource QuestionTypeLabel}}"
                                                                       FontSize="10"
                                                                       Foreground="{DynamicResource PrimaryBrush}"/>
                                                        </Border>
                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding QuestionText}"
                                                                   TextWrapping="Wrap"
                                                                   VerticalAlignment="Center"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                        <TextBlock Grid.Column="3"
                                                                   HorizontalAlignment="Right"
                                                                   VerticalAlignment="Center"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}">
                                                            <Run Text="{Binding MaxPoints}"/>
                                                            <Run Text=" p"/>
                                                        </TextBlock>
                                                        <Button Grid.Column="4"
                                                                Content="Çıkar"
                                                                Command="{Binding DataContext.RemoveQuestionCommand,
                                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource DangerButtonStyle}"
                                                                Padding="9,2" FontSize="11" MinHeight="24"
                                                                Margin="12,0,0,0"
                                                                VerticalAlignment="Center"
                                                                ToolTip="Bu soruyu sınavdan çıkar (soru bankasında kalır)"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="2"
                    Style="{StaticResource EmptyStateStyle}"
                    Visibility="{Binding Exams.Count, Converter={StaticResource CollectionEmptyToVisibility}}">
            <mi:MaterialIcon Kind="FileDocumentOutline" Width="48" Height="48"
                             Foreground="{DynamicResource SubtleBrush}"
                             HorizontalAlignment="Center"/>
            <TextBlock Text="Henüz sınav yok" Style="{StaticResource EmptyStateTitleStyle}"/>
            <TextBlock Text="Sınav Oluştur ekranından yeni sınav oluşturabilirsiniz."
                       Style="{StaticResource EmptyStateDescriptionStyle}"/>
        </StackPanel>

        <views:LoadingOverlay Grid.RowSpan="3"
                              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>

        <Border Grid.RowSpan="3"
                Background="{DynamicResource OverlayBrush}"
                Visibility="{Binding IsEditDialogOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Background="{DynamicResource CardBgBrush}"
                    CornerRadius="{DynamicResource RadiusLg}"
                    Padding="24"
                    Width="540"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Sınavı Düzenle"
                               Style="{StaticResource HeadingStyle}"
                               Margin="0,0,0,16"/>

                    <TextBlock Text="Sınav Başlığı" Style="{StaticResource LabelStyle}"/>
                    <TextBox Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Tarih" Style="{StaticResource LabelStyle}"/>
                            <DatePicker SelectedDate="{Binding EditExamDate}" Padding="8,4"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Süre (dk)" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding EditDurationMinutes, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Sınav Tipi" Style="{StaticResource LabelStyle}"/>
                    <ComboBox SelectedItem="{Binding EditExamType}" Margin="0,0,0,16">
                        <ComboBox.Items>
                            <x:Static Member="enums:ExamType.Quiz"/>
                            <x:Static Member="enums:ExamType.Midterm"/>
                            <x:Static Member="enums:ExamType.Final"/>
                            <x:Static Member="enums:ExamType.MakeUp"/>
                        </ComboBox.Items>
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource ExamTypeLabel}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="İptal"
                                Command="{Binding CancelEditCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,0,8,0"/>
                        <Button Content="Kaydet"
                                Command="{Binding SaveEditCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Mevcut sınava soru ekleme diyaloğu -->
        <Border Grid.RowSpan="3"
                Background="{DynamicResource OverlayBrush}"
                Visibility="{Binding IsAddQuestionsDialogOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Background="{DynamicResource CardBgBrush}"
                    CornerRadius="{DynamicResource RadiusLg}"
                    Padding="24"
                    MaxWidth="1100"
                    Margin="32"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,14">
                        <TextBlock Text="Sınava Soru Ekle" Style="{StaticResource HeadingStyle}"/>
                        <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap">
                            <Run Text="{Binding AddQuestionsExam.Title, Mode=OneWay}" FontWeight="SemiBold"/>
                            <Run Text="  /  "/>
                            <Run Text="{Binding AddQuestionsExam.CourseName, Mode=OneWay}"/>
                            <Run Text="  —  Soru bankasındaki aktif sorular sınavın sonuna eklenir; kitapçıklara da yansıtılır."/>
                        </TextBlock>
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Sol: soru havuzu -->
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Soru Havuzu" Style="{StaticResource SubheadingStyle}"/>

                            <Grid Grid.Row="1" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0"
                                          ItemsSource="{Binding PoolTypeFilters}"
                                          SelectedItem="{Binding SelectedPoolTypeFilter, Mode=TwoWay}"
                                          DisplayMemberPath="Label"
                                          MinHeight="44"/>
                                <TextBox Grid.Column="2"
                                         Text="{Binding PoolSearchText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Soru metninde ara (Enter)">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding SearchPoolCommand}"/>
                                    </TextBox.InputBindings>
                                </TextBox>
                                <Button Grid.Column="4" Content="Ara"
                                        Command="{Binding SearchPoolCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        MinWidth="70"/>
                            </Grid>

                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding PoolQuestions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="{DynamicResource RadiusLg}"
                                                        Padding="12"
                                                        Margin="0,0,0,8"
                                                        Background="{DynamicResource CardBgBrush}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                            <TextBlock Text="{Binding QuestionText}"
                                                                       TextWrapping="Wrap"
                                                                       FontSize="12.5"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                                <Border Style="{StaticResource Chip}" Margin="0,0,6,0">
                                                                    <TextBlock Text="{Binding Type, Converter={StaticResource QuestionTypeLabel}}" Style="{StaticResource ChipText}"/>
                                                                </Border>
                                                                <Border Style="{StaticResource Chip}">
                                                                    <TextBlock Style="{StaticResource ChipText}">
                                                                        <Run Text="{Binding MaxPoints, Mode=OneWay}"/>
                                                                        <Run Text=" puan"/>
                                                                    </TextBlock>
                                                                </Border>
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Content="Ekle"
                                                                Command="{Binding DataContext.AddToPendingCommand,
                                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource PrimaryButtonStyle}"
                                                                Padding="14,5" FontSize="11"
                                                                VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="Bu filtreyle eklenebilecek soru bulunamadı."
                                               Foreground="{DynamicResource SubtleBrush}"
                                               FontSize="12"
                                               Margin="4,8,0,0"
                                               Visibility="{Binding PoolQuestions.Count, Converter={StaticResource CollectionEmptyToVisibility}}"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!-- Sağ: eklenecek sorular -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Eklenecek Sorular" Style="{StaticResource SubheadingStyle}" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="Kalan Puanı Ağırlığa Göre Dağıt"
                                        Command="{Binding FillRemainingPointsCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="10,5" FontSize="11"
                                        ToolTip="Sınavın 100'e kalan puanını, eklenecek soruların mevcut puanlarını ağırlık katsayısı kabul ederek orantılı dağıtır."/>
                            </Grid>

                            <TextBlock Grid.Row="1"
                                       Text="{Binding AddQuestionsPointSummary}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Margin="0,0,0,10"/>

                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding PendingQuestions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource PrimaryBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="{DynamicResource RadiusLg}"
                                                        Padding="12"
                                                        Margin="0,0,0,8"
                                                        Background="{DynamicResource PrimaryLightBrush}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                            <TextBlock Text="{Binding Question.QuestionText}"
                                                                       TextWrapping="Wrap"
                                                                       FontSize="12.5"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                                <Border Style="{StaticResource Chip}" Margin="0,0,8,0">
                                                                    <TextBlock Text="{Binding Question.Type, Converter={StaticResource QuestionTypeLabel}}" Style="{StaticResource ChipText}"/>
                                                                </Border>
                                                                <TextBlock Text="Puan" Style="{StaticResource ChipText}" Margin="0,0,6,0"/>
                                                                <TextBox Text="{Binding Points, Mode=OneWay, StringFormat={}{0:0.##}}"
                                                                         Style="{StaticResource PointInputStyle}"
                                                                         LostFocus="PendingPoints_LostFocus"
                                                                         KeyDown="PendingPoints_KeyDown"
                                                                         ToolTip="Bu sorunun bu sınavdaki puanı. Enter ile onaylayın."/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Content="Çıkar"
                                                                Command="{Binding DataContext.RemoveFromPendingCommand,
                                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource SecondaryButtonStyle}"
                                                                Padding="12,5" FontSize="11"
                                                                VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="Soldaki havuzdan eklemek istediğiniz soruların yanındaki Ekle düğmesine basın."
                                               Foreground="{DynamicResource SubtleBrush}"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Margin="4,8,0,0"
                                               Visibility="{Binding PendingQuestions.Count, Converter={StaticResource CollectionEmptyToVisibility}}"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>

                    <Border Grid.Row="2" Style="{StaticResource AlertErrorStyle}" Margin="0,12,0,0"
                            Visibility="{Binding AddQuestionsError, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding AddQuestionsError}" Foreground="{DynamicResource DangerEmphasisBrush}" TextWrapping="Wrap"/>
                    </Border>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                        <Button Content="İptal"
                                Command="{Binding CancelAddQuestionsCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,0,8,0"/>
                        <Button Content="Sınava Ekle"
                                Command="{Binding ConfirmAddQuestionsCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
