<UserControl x:Class="EduAnalytics.UI.Views.AdminExportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
             Background="{DynamicResource PageBgBrush}">
    <Grid Style="{StaticResource PageRootGridStyle}">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="600">
            <mi:MaterialIcon Kind="DatabaseExport" Width="80" Height="80" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,24"/>
            <TextBlock Text="Sistem Veritabanı Paketleme (Admin Merkezi)" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextAlignment="Center" Margin="0,0,0,16"/>
            <TextBlock Text="Bu ekran sadece sistem yöneticilerine görünür. Buradan programları, dersleri, öğrencileri ve ders kayıtlarını, konuları, öğrenme çıktılarını (ÖÇ), program çıktılarını (PÇ) ve eşleşmelerini, soru bankasını ve isterseniz sınavları ve öğrenci cevaplarını tek bir .edudata paketine dönüştürebilirsiniz. Paketi başka bir bilgisayarda Ayarlar penceresinden içe aktarabilirsiniz."
                       FontSize="15" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,24"/>

            <CheckBox IsChecked="{Binding IncludeExamResults}" HorizontalAlignment="Center" Margin="0,0,0,8">
                <TextBlock Text="Sınavları, öğrenci cevaplarını ve rubrik puanlarını da ekle" FontSize="14"/>
            </CheckBox>
            <TextBlock Text="Paket şifrelenmez. Öğrenci cevapları kişisel veridir; bu seçenekle oluşturulan paketi yalnızca yetkili kişilerle paylaşın."
                       FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,28"/>

            <Button Content="Tüm Veritabanını Dışa Aktar (.edudata)"
                    Command="{Binding ExportDataCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Height="50" FontSize="15" FontWeight="Bold" Padding="32,0"/>
            
            <ProgressBar IsIndeterminate="True" Height="4" Margin="0,24,0,0" Visibility="{Binding IsExporting, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </StackPanel>
    </Grid>
</UserControl>
