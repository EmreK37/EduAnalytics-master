<Window x:Class="EduAnalytics.UI.Views.StudentProfileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mi="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
        Title="Öğrenci Profili" Height="450" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource PageBgBrush}">
    <Border Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,24">
                <Border Width="80" Height="80" CornerRadius="40" Background="{DynamicResource PrimaryBrush}" Margin="0,0,0,12">
                    <TextBlock x:Name="InitialsText" Text="EA" FontSize="30" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="StudentNameText" Text="Öğrenci Adı" FontSize="18.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                <TextBlock x:Name="StudentNumberText" Text="Numara - Sınıf" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>
            
            <Separator Grid.Row="1" Margin="0,0,0,16" Background="{DynamicResource BorderBrush}"/>

            <!-- Stats/Exams -->
            <Grid Grid.Row="2">
                <StackPanel>
                    <TextBlock Text="Sınav Performansı" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="120">
                    <ItemsControl x:Name="ExamsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding ExamName}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Date, StringFormat={}{0:dd.MM.yyyy}}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding ScoreDisplay}" FontWeight="Bold" FontSize="17" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center"
                                                   ToolTip="Sınav analizi ve sıralamayla aynı hesap: sınava özgü soru puanları kullanılır, iptal edilen sorular sayılmaz."/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </ScrollViewer>
                    
                    <TextBlock x:Name="EmptyStateText" Text="Henüz girilmiş bir sınav notu yok." Foreground="{DynamicResource SubtleBrush}" FontStyle="Italic" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,20,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Close Button -->
            <Button Grid.Row="3" Content="Kapat" IsCancel="True" Style="{StaticResource PrimaryButtonStyle}" Height="40" Margin="0,16,0,0" Click="Close_Click"/>
        </Grid>
    </Border>
</Window>
